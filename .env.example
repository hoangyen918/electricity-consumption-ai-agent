OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=qwen/qwen3.6-27b

# Embedding: self-hosted TEI qua docker-compose.yml (service "embeddings"), khởi động
# bằng `docker compose up -d embeddings`. Giá trị bên dưới là cổng publish ra host
# (127.0.0.1:8000) — dùng khi chạy script trên host (ví dụ scripts/ingest_kb.py). App
# chạy trong compose tự override sang http://embeddings:80/v1 nội bộ.
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=electricity_kb
MAX_AGENT_ITERATIONS=5
RAG_TOP_K=10
APP_REFERER=http://localhost:8501
APP_TITLE=Electricity Consumption AI Agent
